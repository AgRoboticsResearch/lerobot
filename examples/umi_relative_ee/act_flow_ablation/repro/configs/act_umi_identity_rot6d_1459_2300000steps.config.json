        "observation.images.camera": {
            "type": "VISUAL",
            "shape": [
                3,
                480,
                640
            ]
        },
        "observation.state": {
            "type": "STATE",
            "shape": [
                20
            ]
        }
    },
    "output_features": {
        "action": {
            "type": "ACTION",
            "shape": [
                10
            ]
        }
    },
    "device": "cuda",
    "use_amp": false,
    "use_peft": false,
    "push_to_hub": false,
    "repo_id": "zfff/act_umi_identity_rot6d_1459",
    "private": null,
    "tags": null,
    "license": null,
    "pretrained_path": "outputs/train/act_umi_identity_rot6d_1459/checkpoints/last/pretrained_model",
    "chunk_size": 30,
    "n_action_steps": 30,
    "use_umi_relative_ee": true,
